
# ==========================================
# Keil uVision user-specific settings
# ==========================================
*.uvopt
*.uvoptx
*.uvgui
*.uvguix*
*.uvguix.*

# ==========================================
# Keil generated build files
# ==========================================
*.o
*.obj
*.d
*.crf
*.dep
*.lnp
*.map
*.axf
*.elf
*.htm
*.build_log.htm
*. bak

# ==========================================
# Ignore generated output folders by default
# ==========================================
**/Objects/*
**/Listings/*
**/Debug/*
**/Release/*

# ==========================================
# Keep required firmware and listing outputs
# ==========================================
!**/Objects/
!**/Listings/
!**/Objects/*.hex
!**/Objects/*.HEX
!**/Listings/*.lst
!**/Listings/*.LST

# ==========================================
# Temporary files
# ==========================================
*.bak
*.tmp
*.swp
*.log

# ==========================================
# Operating system files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
